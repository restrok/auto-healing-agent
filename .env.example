# Telegram Notifications and HITL Dispatch
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# LLM Cognitive Root Cause Analysis
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_API_KEY=your_ollama_api_key_here
LLM_MODEL=deepseek-v4.1-flash
LLM_CALL_TIMEOUT=45.0
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=60.0

# HITL & Orchestrator Integration
ORCHESTRATOR_API_URL=http://localhost:8001
ORCHESTRATOR_DB_PATH=./data/orchestrator.db
REQUESTER_ID=auto-healer

# System Thresholds & Auto-Healing Behavior
HEAL_DISK_WARN=75.0
HEAL_DISK_CRIT=85.0
HEAL_MEM_MIN_MB=1500.0
HEAL_SWAP_MAX_MB=4000.0
HEAL_MAX_REMEDIATIONS=2
HEAL_COOLDOWN_SEC=20
HEAL_LOG_SCAN_HOURS=24
HEALING_DB_PATH=./healing_history.sqlite
# HEAL_DB_PATH is also supported for backwards compatibility
